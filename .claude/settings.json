{
  "permissions": {
    "allow": ["Read", "Grep", "Glob", "WebFetch"],
    "deny": ["shell rm -rf", "shell git push --force"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "echo 'Shell command intercepted' >&2" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [{ "type": "command", "command": "python3 tools/validate_skills.py --quiet 2>/dev/null || true" }]
      }
    ]
  }
}
